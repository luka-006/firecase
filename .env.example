# Javni URL stranice (produkcija), npr. https://firecase.net
NEXT_PUBLIC_SITE_URL=https://firecase.net

# Baza (Vercel > Storage > Neon Postgres - postavlja se automatski)
DATABASE_URL=

# Slike proizvoda (Vercel > Storage > Blob - postavlja se automatski)
BLOB_READ_WRITE_TOKEN=

# Nasumičan dugi niz (min. 32 znaka) za potpisivanje prijava
AUTH_SECRET=

# Lozinka za /admin
ADMIN_PASSWORD=

# Stripe (Dashboard > Developers > API keys / Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Staff sourcing (/staff) — zasebno od admina
STAFF_PASSWORD=
STAFF_API_TOKEN=

# Cloudflare Turnstile (registracija / prijava kodom)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# E-mail (Resend: https://resend.com — verificiraj domenu firecase.net, API key)
RESEND_API_KEY=
MAIL_FROM=Firecase <info@firecase.net>
ORDER_NOTIFY_EMAIL=info@firecase.net

# Fiskalizacija: FINA certifikat (.p12) kao base64 + lozinka
# base64 -w0 certifikat.p12
FISCAL_CERT_BASE64=
FISCAL_CERT_PASSWORD=
# (opcionalno) PEM CA certifikat ako CIS server nije u zadanom popisu
FISCAL_CA_PEM=

# Automatski prijevod opisa proizvoda HR -> EN (DeepL API Free, besplatno do 500.000 znakova mjesečno)
DEEPL_API_KEY=

# Google Analytics 4 (Measurement ID, npr. G-XXXXXXXXXX) - učitava se tek uz privolu kolačića
NEXT_PUBLIC_GA_ID=
# Google Search Console - HTML tag verifikacija (samo vrijednost content="...")
NEXT_PUBLIC_GSC_VERIFICATION=

# Vercel Cron (nasumičan niz)
CRON_SECRET=
