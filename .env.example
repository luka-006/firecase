# Javni URL stranice (nakon spajanja domene), npr. https://firecase.hr
NEXT_PUBLIC_SITE_URL=

# Baza (Vercel > Storage > Neon Postgres - postavlja se automatski)
DATABASE_URL=

# Slike proizvoda (Vercel > Storage > Blob - postavlja se automatski)
BLOB_READ_WRITE_TOKEN=

# Nasumičan dugi niz (min. 32 znaka) za potpisivanje prijava
AUTH_SECRET=

# Lozinka za /admin
ADMIN_PASSWORD=

# Stripe (Dashboard > Developers > API keys / Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Slanje e-maila (Gmail: smtp.gmail.com, 465, app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=luka.kasalo.web@gmail.com
SMTP_PASS=
MAIL_FROM=Firecase <luka.kasalo.web@gmail.com>
ORDER_NOTIFY_EMAIL=luka.kasalo.web@gmail.com

# Fiskalizacija: FINA certifikat (.p12) kao base64 + lozinka
# base64 -w0 certifikat.p12
FISCAL_CERT_BASE64=
FISCAL_CERT_PASSWORD=
# (opcionalno) PEM CA certifikat ako CIS server nije u zadanom popisu
FISCAL_CA_PEM=

# Vercel Cron (nasumičan niz)
CRON_SECRET=
